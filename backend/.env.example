# Graph backend: local (DuckDB mirror, default) | tigergraph (REST) | mcp (official TigerGraph MCP server)
GRAPH_BACKEND=local
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_GRAPH=TigraGraph
TG_SECRET=
TG_USERNAME=tigergraph
TG_PASSWORD=
# Optional LLM for summaries / SAR narratives (decisions never depend on it)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
