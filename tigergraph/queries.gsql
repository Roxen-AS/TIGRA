// Installed queries backing the agent's graph tools (one per tool in backend/tigra/tools.py).
// Traversal, filtering and aggregation run in TigerGraph; quantiles are finished client-side in store_tg.py.
USE GRAPH TigraGraph

// Card -> MADE -> Txn before a timestamp (behavioural baseline input).
CREATE OR REPLACE QUERY card_history(VERTEX<Card> card, DATETIME before_ts) FOR GRAPH TigraGraph {
  S = {card};
  T = SELECT t FROM S:s -(MADE:e)- Txn:t WHERE t.ts < before_ts;
  PRINT T[T.txn_id, T.ts, T.amt, T.product, T.channel, T.addr1, T.p_email, T.device_id] AS txns;
}

// Card -> MADE -> Txn inside a time window.
CREATE OR REPLACE QUERY card_window(VERTEX<Card> card, DATETIME start_ts, DATETIME end_ts, INT lim = 400) FOR GRAPH TigraGraph {
  S = {card};
  T = SELECT t FROM S:s -(MADE:e)- Txn:t WHERE t.ts >= start_ts AND t.ts <= end_ts ORDER BY t.ts ASC LIMIT lim;
  PRINT T AS txns;
}

// Card history restricted to one device / email / region before a timestamp.
CREATE OR REPLACE QUERY card_attr_seen(VERTEX<Card> card, STRING attr, STRING val, DATETIME before_ts) FOR GRAPH TigraGraph {
  SumAccum<INT> @@n;
  MinAccum<DATETIME> @@first;
  SetAccum<STRING> @@days;
  S = {card};
  T = SELECT t FROM S:s -(MADE:e)- Txn:t
      WHERE t.ts < before_ts AND ((attr == "device" AND t.device_id == val) OR (attr == "email" AND t.p_email == val)
                                  OR (attr == "region" AND t.addr1 == val))
      ACCUM @@n += 1, @@first += t.ts, @@days += datetime_format(t.ts, "%Y-%m-%d");
  PRINT @@n AS n, @@first AS first_ts, @@days.size() AS days;
}

// Same product (and region for card-present) at ~the same amount earlier on the card: recurring-charge check (R7).
CREATE OR REPLACE QUERY amount_recurrence(VERTEX<Card> card, INT before_txn, DOUBLE lo, DOUBLE hi, STRING prod, STRING reg) FOR GRAPH TigraGraph {
  SumAccum<INT> @@scope;
  S = {card};
  P = SELECT t FROM S:s -(MADE:e)- Txn:t
      WHERE t.txn_id < before_txn AND t.product == prod AND (prod != "W" OR t.addr1 == reg)
      ACCUM @@scope += 1;
  H = SELECT t FROM P:t WHERE t.amt >= lo AND t.amt <= hi ORDER BY t.ts ASC;
  PRINT H[H.txn_id, H.ts, H.amt, H.addr1, H.p_email, H.device_id] AS hits;
  PRINT @@scope AS scope_n;
}

// DeviceProfile <- FROM_DEVICE <- Txn -> MADE -> Card, plus closed cases that touched the device (shared-origin check, R6).
CREATE OR REPLACE QUERY device_neighbors(VERTEX<DeviceProfile> dev, DATETIME start_ts, DATETIME end_ts) FOR GRAPH TigraGraph {
  SetAccum<STRING> @@cards;
  SumAccum<INT> @@n;
  MinAccum<DATETIME> @@first;
  MaxAccum<DATETIME> @@last;
  D = {dev};
  A = SELECT t FROM D:d -(FROM_DEVICE:e)- Txn:t
      ACCUM @@n += 1, @@cards += t.card_id, @@first += t.ts, @@last += t.ts;
  W = SELECT t FROM A:t WHERE t.ts >= start_ts AND t.ts <= end_ts ORDER BY t.ts ASC LIMIT 600;
  C = SELECT c FROM A:t -(INVOLVES:e)- ClosedCase:c;
  PRINT D[D.profile] AS device;
  PRINT @@n AS n_txn, @@cards.size() AS n_cards, @@first AS first_ts, @@last AS last_ts;
  PRINT W AS window_txns;
  PRINT C[C.card_id, C.outcome, C.pattern, C.opened_at] AS closed_cases;
}

// Customer -> OWNS -> Card -> ON_CARD/CASE_ON_CARD -> case memory (closed history + agent-written cases).
CREATE OR REPLACE QUERY prior_cases(VERTEX<Customer> cust, DATETIME before_ts) FOR GRAPH TigraGraph {
  S = {cust};
  K = SELECT k FROM S:s -(OWNS:e)- Card:k;
  CC = SELECT c FROM K:k -(ON_CARD:e)- ClosedCase:c WHERE c.opened_at < before_ts;
  FC = SELECT f FROM K:k -(CASE_ON_CARD:e)- FraudCase:f WHERE f.opened_at < before_ts;
  PRINT CC AS closed_cases;
  PRINT FC AS agent_cases;
}

CREATE OR REPLACE QUERY customer_cards(VERTEX<Customer> cust) FOR GRAPH TigraGraph {
  SumAccum<INT> @n;
  S = {cust};
  K = SELECT k FROM S:s -(OWNS:e)- Card:k -(MADE:m)- Txn:t ACCUM k.@n += 1;
  PRINT K[K.network, K.card_type, K.@n] AS cards;
}

// GraphRAG: cosine top-k over Doc.embedding (TigerGraph 4.x vector search).
CREATE OR REPLACE QUERY kb_search(LIST<FLOAT> qv, INT k = 4) FOR GRAPH TigraGraph {
  MapAccum<VERTEX, FLOAT> @@dist;
  R = vectorSearch({Doc.embedding}, qv, k, {distance_map: @@dist});
  PRINT R[R.title, R.text, R.source] AS docs;
  PRINT @@dist AS dist;
}

// Case-memory expansion: from a FraudCase, the cards/devices it touched and every other case on them.
CREATE OR REPLACE QUERY case_neighbourhood(VERTEX<FraudCase> fc) FOR GRAPH TigraGraph {
  S = {fc};
  K = SELECT k FROM S:s -((CASE_ON_CARD|CASE_CONNECTED):e)- Card:k;
  DV = SELECT d FROM S:s -(CASE_DEVICE:e)- DeviceProfile:d;
  O1 = SELECT c FROM K:k -((ON_CARD|CONNECTED_TO):e)- ClosedCase:c;
  O2 = SELECT f FROM K:k -((CASE_ON_CARD|CASE_CONNECTED):e)- FraudCase:f WHERE f != fc;
  PRINT K, DV, O1 AS closed_cases, O2 AS agent_cases;
}

// Behavioural features of every closed case (memory index input), aggregated over ClosedCase -INVOLVES- Txn.
CREATE OR REPLACE QUERY closed_case_features() FOR GRAPH TigraGraph {
  SumAccum<INT> @n, @online, @newdev, @proxy;
  MinAccum<DOUBLE> @amin;
  MaxAccum<DOUBLE> @amax, @rmax;
  MinAccum<DATETIME> @t0;
  MaxAccum<DATETIME> @t1;
  MapAccum<STRING, SumAccum<INT>> @prod;
  SetAccum<STRING> @devs;
  C = {ClosedCase.*};
  C = SELECT c FROM C:c -(INVOLVES:e)- Txn:t
      ACCUM c.@n += 1, c.@amin += t.amt, c.@amax += t.amt, c.@rmax += t.risk_score, c.@t0 += t.ts, c.@t1 += t.ts,
            c.@prod += (t.product -> 1),
            IF t.channel == "online" THEN c.@online += 1 END,
            IF t.device_status == "New" THEN c.@newdev += 1 END,
            IF t.proxy != "" THEN c.@proxy += 1 END,
            IF t.device_id != "" THEN c.@devs += t.device_id END;
  PRINT C[C.customer_id, C.card_id, C.outcome, C.pattern, C.opened_at, C.exposure_usd, C.n_txns, C.report_filed,
          C.analyst_notes, C.@n, C.@online, C.@newdev, C.@proxy, C.@amin, C.@amax, C.@rmax, C.@t0, C.@t1, C.@prod, C.@devs] AS cases;
}

INSTALL QUERY closed_case_features, card_history, card_window, card_attr_seen, amount_recurrence, device_neighbors, prior_cases,
              customer_cards, kb_search, case_neighbourhood
